---
/**
 * A handwritten margin note: asides, warnings, "notice that…". The optional id is rendered, because lint
 * accepts an id on any tag as a misconception-remedy or summary anchor.
 */
interface Props {
  kind?: 'note' | 'warn';
  id?: string;
}
const { kind = 'note', id } = Astro.props;
---

<aside id={id} class={`note hand note-${kind}`}><slot /></aside>
